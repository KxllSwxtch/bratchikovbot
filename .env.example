# Токен бота от @BotFather
BOT_TOKEN=

# PostgreSQL. На сервере база живёт локально — это убирает
# трансатлантический round-trip, который был на Heroku (us-east-1).
DATABASE_URL=postgresql://bratchikov:CHANGE_ME@localhost:5432/bratchikovbot

# Прокси. Оставить пустыми — с VPS все сайты (encar, globalapi.che168.com,
# kbchachacha, kcar) доступны напрямую, прокси не требуется.
DATACENTER_PROXY_URL=
CHE168_PROXY_URL=

# Курс, по которому global.che168.com переводит цену в юанях в доллары.
# Бот восстанавливает цену в юанях как $ × курс (с округлением до 100 ¥).
# Если в логах появилось "site CNY/USD rate may have changed", пересчитайте:
# цена в ¥ на m.che168.com ÷ цена в $ на global.che168.com для 2–3 машин.
CHE168_CNY_PER_USD=6.575
