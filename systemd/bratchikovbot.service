[Unit]
Description=Bratchikov Telegram Bot (Импорт без проблем)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
# Обязательно: load_dotenv() читает .env из рабочей директории,
# а save_custom_rate()/load_custom_rate() пишут custom_rate.json
# по относительному пути.
WorkingDirectory=/opt/bratchikovbot
Environment=PYTHONUNBUFFERED=1
Environment=LANG=en_US.UTF-8
Environment=LC_ALL=en_US.UTF-8
ExecStart=/opt/bratchikovbot/.venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
